{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "../CSV files/nba5_csvs/fresh_blood/fb_issues_by_remoteness_year.csv"},
  "title": "Share of issued blood products discarded, by remoteness and yea",
  "params": [{
    "name": "product_pick",
    "value": "Red blood cells",
    "bind": {"input": "select", "name": "Product: ",
             "options": ["Red blood cells", "Platelets", "Fresh frozen plasma"]}
  }],
  "transform": [
    {"filter": "datum.measure == 'discards_pct_of_issues' && datum.product == product_pick"}
  ],
  "width": 360,
  "height": 220,
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": "Financial year"},
        "y": {"field": "remoteness", "type": "ordinal", "title": null,
              "sort": ["Major Cities of Australia", "Inner Regional Australia",
                       "Outer Regional Australia", "Remote Australia",
                       "Very Remote Australia"]},
        "color": {"field": "value", "type": "quantitative", "title": "Discarded (% of issues)",
                  "scale": {"scheme": "blues"}},
        "tooltip": [{"field": "remoteness"}, {"field": "year"},
                    {"field": "value", "title": "% discarded"}]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "remoteness", "type": "ordinal",
              "sort": ["Major Cities of Australia", "Inner Regional Australia",
                       "Outer Regional Australia", "Remote Australia",
                       "Very Remote Australia"]},
        "text": {"field": "value", "type": "quantitative", "format": ".1f"},
        "color": {"condition": {"test": "datum.value > 6", "value": "white"}, "value": "black"}
      }
    }
  ]
}